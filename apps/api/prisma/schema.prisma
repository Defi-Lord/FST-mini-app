// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Core user of your app (admin or player).
 */
model User {
  id        String   @id @default(cuid())
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  wallets        Wallet[]
  sessions       Session[]
  activities     Activity[]
  participations Participation[]

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
}

/**
 * A blockchain wallet that can sign in (SIWS / Phantom).
 */
model Wallet {
  id        String   @id @default(cuid())
  address   String   @unique
  provider  String?
  createdAt DateTime @default(now())

  // Optional owner
  userId String?
  user   User?    @relation(fields: [userId], references: [id])

  // Relations
  nonces      Nonce[]
  sessions    Session[]
  activities  Activity[]
  participations Participation[]

  @@map("wallets")
}

/**
 * Server-issued short-lived nonce used for SIWS.
 */
model Nonce {
  id        String   @id @default(cuid())
  value     String
  expiresAt DateTime

  // Link to wallet (optional)
  walletId String?
  wallet   Wallet?  @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())

  @@index([walletId])
  @@map("nonces")
}

/**
 * Session (JWT jti or server-managed session).
 */
model Session {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime?

  // Optional links
  userId   String?
  user     User?    @relation(fields: [userId], references: [id])

  walletId String?
  wallet   Wallet?  @relation(fields: [walletId], references: [id])

  activities Activity[]

  @@index([userId])
  @@index([walletId])
  @@map("sessions")
}

/**
 * Contest catalog.
 */
model Contest {
  id          String   @id @default(cuid())
  title       String
  description String?
  entryFee    Decimal? @db.Decimal(18, 6)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participations Participation[]
  activities     Activity[]

  @@map("contests")
}

/**
 * Participation of a user in a contest, with fee paid and tx info.
 */
model Participation {
  id         String   @id @default(cuid())
  userId     String
  contestId  String
  walletId   String?

  feePaid    Decimal? @db.Decimal(18, 6)
  txHash     String?
  status     ParticipationStatus @default(PENDING)
  joinedAt   DateTime @default(now())

  // Relations
  user    User      @relation(fields: [userId], references: [id])
  contest Contest   @relation(fields: [contestId], references: [id])
  wallet  Wallet?   @relation(fields: [walletId], references: [id])

  activities Activity[]

  @@unique([userId, contestId])
  @@index([walletId])
  @@map("participations")
}

enum ParticipationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/**
 * Audit trail of important events.
 */
model Activity {
  id        String   @id @default(cuid())
  type      ActivityType
  message   String?
  meta      Json?
  ip        String?
  userAgent String?

  // Optional back-references to attach the event
  userId          String?
  walletId        String?
  sessionId       String?
  contestId       String?
  participationId String?

  user          User?          @relation(fields: [userId], references: [id])
  wallet        Wallet?        @relation(fields: [walletId], references: [id])
  session       Session?       @relation(fields: [sessionId], references: [id])
  contest       Contest?       @relation(fields: [contestId], references: [id])
  participation Participation? @relation(fields: [participationId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([walletId])
  @@index([sessionId])
  @@index([contestId])
  @@index([participationId])
  @@map("activities")
}

enum ActivityType {
  WALLET_CONNECTED
  SIGN_IN_REQUESTED
  SIGN_IN_SUCCEEDED
  SIGN_IN_FAILED
  PARTICIPATION_CREATED
  PARTICIPATION_PAID
  PARTICIPATION_CANCELLED
  ADMIN_VIEWED_DASHBOARD
}
