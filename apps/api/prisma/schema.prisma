// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

/**
 * Core user of your app (admin or player).
 */
model User {
  id        String   @id @default(cuid())
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  wallets        Wallet[]
  sessions       Session[]
  activities     Activity[]
  participations Participation[]
}

/**
 * A blockchain wallet that can sign in (SIWS / Phantom).
 */
model Wallet {
  id        String   @id @default(cuid())
  address   String   @unique
  provider  String?
  createdAt DateTime @default(now())

  // Optional owner
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Back-relations
  nonces         Nonce[]
  sessions       Session[]
  activities     Activity[]
  participations Participation[]
}

/**
 * Server-issued short-lived nonce used for SIWS.
 */
model Nonce {
  id        String   @id @default(cuid())
  value     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  @@index([walletId])
}

/**
 * Session (JWT jti or server-managed session).
 */
model Session {
  id        String    @id @default(cuid())
  jti       String?   @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  ip        String?
  userAgent String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([walletId])
}

/**
 * Contest catalog.
 */
model Contest {
  id          String        @id @default(cuid())
  name        String
  description String?
  entryFee    Decimal       @db.Decimal(65, 30)
  status      ContestStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime      @default(now())

  // Relations
  participations Participation[]
  activities     Activity[]
}

/**
 * Participation of a user in a contest, with fee paid and tx info.
 */
model Participation {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  paidAmount Decimal  @db.Decimal(65, 30)
  txHash     String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])

  // Optional wallet used to pay
  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  // Audit entries for this participation
  activities Activity[]

  @@unique([userId, contestId]) // one active participation per user per contest (change if you allow multiple)
  @@index([userId])
  @@index([contestId])
  @@index([walletId])
}

/**
 * Audit trail of important events.
 */
model Activity {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  type      ActivityType
  message   String?
  meta      Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  participationId String?
  participation   Participation? @relation(fields: [participationId], references: [id])

  contestId String?
  contest   Contest? @relation(fields: [contestId], references: [id])

  @@index([userId])
  @@index([walletId])
  @@index([participationId])
  @@index([contestId])
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum ContestStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ActivityType {
  USER_REGISTERED
  WALLET_CONNECTED
  WALLET_VERIFIED
  NONCE_ISSUED
  NONCE_USED
  SESSION_STARTED
  SESSION_ENDED
  CONTEST_CREATED
  CONTEST_ACTIVATED
  CONTEST_CLOSED
  PARTICIPATION_CREATED
  PARTICIPATION_PAID
}
