// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Roles for your app’s users
enum UserRole {
  ADMIN
  USER
}

/// Types of audit activities to capture
enum ActivityType {
  WALLET_CONNECTED
  WALLET_DISCONNECTED
  AUTH_SIGN_IN
  AUTH_SIGN_OUT
  CONTEST_VIEWED
  CONTEST_JOINED
  FEE_PAID
  PARTICIPATION_SUBMITTED
  PARTICIPATION_CANCELLED
  ADMIN_VIEW_AUDIT
}

/// Core user of your app (admin or player).
model User {
  id        String   @id @default(cuid())
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  wallets        Wallet[]
  sessions       Session[]
  activities     Activity[]
  participations Participation[]
}

/// A blockchain wallet that can sign in (SIWS / Phantom).
model Wallet {
  id        String   @id @default(cuid())
  address   String   @unique
  provider  String?
  createdAt DateTime @default(now())

  // Optional owner
  userId String?
  user   User?     @relation(fields: [userId], references: [id])

  // Relations
  sessions       Session[]
  activities     Activity[]
  participations Participation[]
}

/// Server-issued short-lived nonce used for SIWS.
model Nonce {
  id        String   @id @default(cuid())
  value     String   @unique
  expiresAt DateTime

  // Optional linkage to a wallet/address if you want
  walletId String?
  wallet   Wallet?  @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
}

/// Session (JWT jti or server-managed session).
model Session {
  id         String   @id @default(cuid())
  jti        String?  @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime?

  // Optional links
  userId   String?
  user     User?    @relation(fields: [userId], references: [id])

  walletId String?
  wallet   Wallet?  @relation(fields: [walletId], references: [id])

  activities Activity[]
}

/// Contest catalog.
model Contest {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  // Fee in token units, use Decimal for precision
  feeAmount   Decimal  @default(0)
  feeToken    String?  // e.g. "SOL", "USDC"

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participations Participation[]
  activities     Activity[]
}

/// Participation of a user in a contest, with fee paid and tx info.
model Participation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Links
  contestId String
  contest   Contest  @relation(fields: [contestId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  // Payment details
  feeAmount Decimal @default(0)
  feeToken  String?
  txHash    String?  @unique

  // Optional status
  status String? // e.g. "PAID" | "PENDING" | "REFUNDED"

  activities Activity[]
}

/// Audit trail of important events.
model Activity {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  type      ActivityType

  // Optional foreign keys to provide context
  userId           String?
  user             User?         @relation(fields: [userId], references: [id])

  walletId         String?
  wallet           Wallet?       @relation(fields: [walletId], references: [id])

  sessionId        String?
  session          Session?      @relation(fields: [sessionId], references: [id])

  contestId        String?
  contest          Contest?      @relation(fields: [contestId], references: [id])

  participationId  String?
  participation    Participation? @relation(fields: [participationId], references: [id])

  // Request context
  ip        String?
  userAgent String?

  // Extra JSON payload (e.g., request body, parsed SIWS msg, etc.)
  meta Json?
}
