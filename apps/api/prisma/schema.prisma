// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
// Enums
// ───────────────────────────────────────────────────────────
enum UserRole {
  USER
  ADMIN
}

enum ActivityType {
  CONNECT_WALLET
  SIGN_IN
  SIGN_OUT
  JOIN_CONTEST
  PAY_FEE
  SUBMIT_SCORE
  UPDATE_PROFILE
  ADMIN_ACTION
}

// ───────────────────────────────────────────────────────────
// Models
// ───────────────────────────────────────────────────────────

/**
 * Core user of your app (admin or player).
 */
model User {
  id        String   @id @default(cuid())
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  wallets        Wallet[]
  sessions       Session[]
  activities     Activity[]
  participations Participation[]
}

/**
 * A blockchain wallet that can sign in (SIWS / Phantom).
 */
model Wallet {
  id        String   @id @default(cuid())
  address   String   @unique
  provider  String?
  createdAt DateTime @default(now())

  // Optional owner
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Back-relations
  sessions       Session[]
  nonces         Nonce[]
  activities     Activity[]
  participations Participation[]
}

/**
 * Server-issued short-lived nonce used for SIWS.
 */
model Nonce {
  id        String    @id @default(cuid())
  value     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  @@index([walletId])
}

/**
 * Session (JWT jti or server-managed session).
 */
model Session {
  id        String   @id @default(cuid())
  jti       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  activities Activity[]

  @@index([userId])
  @@index([walletId])
}

/**
 * Contest catalog.
 */
model Contest {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  entryFee  Int // store fee in minor units (e.g. lamports)
  token     String? // optional symbol/code
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  participations Participation[]
  activities     Activity[]
}

/**
 * Participation of a user in a contest, with fee paid and tx info.
 */
model Participation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  feePaid Int? // minor units
  txHash  String? // chain tx id

  @@unique([userId, contestId])
  @@index([contestId])
  @@index([walletId])
}

/**
 * Audit trail of important events.
 */
model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  message   String?
  createdAt DateTime     @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  contestId String?
  contest   Contest? @relation(fields: [contestId], references: [id])

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([walletId])
  @@index([contestId])
  @@index([sessionId])
}
